{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "电商运营终端",
  "version": "1.3.7",
  "identifier": "com.evovex.evoflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1521",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1521 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "电商运营终端",
        "width": 1440,
        "height": 810,
        "minWidth": 960,
        "minHeight": 540,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#05040f",
        "additionalBrowserArgs": "--use-fake-ui-for-media-stream --enable-features=MediaSession"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$HOME/**/*",
            "$DOCUMENT/**",
            "$DOCUMENT/**/*",
            "$DESKTOP/**",
            "$DESKTOP/**/*",
            "$DOWNLOAD/**",
            "$DOWNLOAD/**/*",
            "**",
            "**/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "publisher": "EvovexAI",
    "copyright": "Copyright © 2024-2026 EvovexAI. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "电商运营终端 — AI 员工与电商生产编排工作台",
    "longDescription": "电商运营终端：基于 EvoFlow（EvovexAI，PolyForm Noncommercial 授权）定制的智能体编排桌面工作台，内置 Tauri v2 面板。",
    "licenseFile": "windows/installer-license.txt",
    "resources": [
      "binaries/evoflow-gateway",
      "windows/install-data.ps1",
      "windows/uninstall-data.ps1",
      "../kws-sidecar",
      "../public/kws"
    ],
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)|(obsidian://\\w+)).+|file:///.+"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFOUQxRDI2MENGRUU0ODEKUldTQjVQNE1KaDJkM25Na3RLMjVualJiMUdPdVlENHQ1SE83YmQzQzZhcGNxRXgzaW9uanlYd3oK",
      "endpoints": [
        "https://localhost/evoflow-fork-auto-update-disabled.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
