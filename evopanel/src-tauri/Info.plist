<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 单安装包统一壳 1.4.5：evoflow:// 深链辅注册（macOS）。Tauri 会把本文件
       合并进生成的 Info.plist。Windows 只留 handle_deep_link 代码路径，不打包
       URL scheme（见 commands/workbench_shell.rs）。 -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.evovex.evoflow.deeplink</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>evoflow</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
